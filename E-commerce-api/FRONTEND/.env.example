# Stripe publishable key only. Never put STRIPE_SECRET_KEY in the frontend.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
# Development uses Vite's same-origin /api proxy. Staging/production must use the deployed HTTPS API URL.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
