# Copy this file to .env and replace every placeholder. Never commit .env.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_development
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ENABLED=false
REDIS_URL=
SENTRY_DSN=
ENVIRONMENT=development
EXPOSE_RESET_TOKEN_IN_DEVELOPMENT=false

# JSON list of trusted browser origins. Use the actual HTTPS frontend URL in
# production; do not use "*" when credentials are enabled.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5174"]

# Absolute URLs used when constructing links in emails or webhooks.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Enable only temporarily when troubleshooting SQL locally.
SQL_ECHO=false
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

# Stripe (test keys begin with sk_test_ and whsec_). Keep real keys only in
# your deployment secret store; do not commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
