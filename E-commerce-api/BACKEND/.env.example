# Copy this file to .env and replace every value with deployment-specific secrets.
# Never commit the resulting .env file.
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>
SECRET_KEY=<generate-a-cryptographically-random-32-byte-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
