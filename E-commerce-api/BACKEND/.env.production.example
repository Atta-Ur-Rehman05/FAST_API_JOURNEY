# Configure these values in your hosting provider's secret manager. This file
# is a schema/template only and must never contain live credentials.
ENVIRONMENT=production
CORS_ORIGINS=["https://shop.example.com"]
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/ecommerce_production
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ENABLED=true
REDIS_URL=redis://<host>:6379/0
SENTRY_DSN=
EXPOSE_RESET_TOKEN_IN_DEVELOPMENT=false
SQL_ECHO=false
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd
